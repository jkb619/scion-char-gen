# Copy to secrets/llm-keys.yaml and encrypt with SOPS:
#   cp secrets/llm-keys.yaml.example secrets/llm-keys.yaml
#   sops --encrypt --in-place secrets/llm-keys.yaml
#
# Local dev (decrypt into process env):
#   sops exec-env secrets/llm-keys.yaml 'make run'
#
# Sync to AWS SSM (Lightsail deploy reads /scion-chargen/production/llm-env):
#   ./scripts/sync-llm-keys-to-ssm.sh

SCION_LLM_DEFAULT_PROVIDER: openai
SCION_LLM_OPENAI_API_KEY: ""
SCION_LLM_OPENAI_MODEL: gpt-4o-mini
SCION_LLM_OPENAI_BASE_URL: https://api.openai.com/v1
SCION_LLM_XAI_API_KEY: ""
SCION_LLM_XAI_MODEL: grok-2-latest
SCION_LLM_XAI_BASE_URL: https://api.x.ai/v1
