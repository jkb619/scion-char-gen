# Local LLM keys (plaintext, gitignored). Copy to secrets/llm-keys.local.yaml and restart the server.
# Loaded automatically on startup when SCION_LLM_* env vars are not already set.
#
#   cp secrets/llm-keys.local.yaml.example secrets/llm-keys.local.yaml
#   # edit secrets/llm-keys.local.yaml — then make run (or make run-https)

SCION_LLM_DEFAULT_PROVIDER: xai
SCION_LLM_XAI_API_KEY: "your-xai-api-key"
SCION_LLM_XAI_MODEL: grok-2-latest
SCION_LLM_XAI_BASE_URL: https://api.x.ai/v1
# Optional: xAI Collections id for Scion 2e PDF RAG (console.x.ai → Collections)
SCION_LLM_XAI_COLLECTION_ID: ""

# OpenAI alternative:
# SCION_LLM_DEFAULT_PROVIDER: openai
# SCION_LLM_OPENAI_API_KEY: "your-openai-api-key"
# SCION_LLM_OPENAI_MODEL: gpt-4o-mini
